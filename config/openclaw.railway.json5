{
  // Railway uses Telegram long polling; the gateway has no public listener.
  gateway: {
    mode: "local",
    bind: "loopback",
    port: 18789,
    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
      allowTailscale: false,
    },
    nodes: {
      pairing: {
        autoApproveLocal: false,
        sshVerify: false,
      },
      commands: { allow: [], deny: ["*"] },
    },
  },
  session: { dmScope: "per-channel-peer" },
  agents: {
    defaults: {
      workspace: "/data/jarvis-v1/workspace",
      userTimezone: "${JARVIS_TIMEZONE}",
      model: {
        primary: "openai/gpt-5.6-luna",
        fallbacks: [],
      },
      modelPolicy: { allow: ["openai/gpt-5.6-luna"] },
      models: {
        "openai/gpt-5.6-luna": {
          agentRuntime: { id: "openclaw" },
          params: { thinking: "low", fastMode: false },
        },
      },
      thinkingDefault: "low",
      heartbeat: { every: "0m" },
      // Railway cannot provide a nested Podman/Docker sandbox. The allowlist below
      // exposes only deterministic plugin tools and denies every broad host tool.
      sandbox: { mode: "off" },
    },
  },
  channels: {
    telegram: {
      enabled: true,
      tokenFile: "/data/jarvis-v1/credentials/telegram-bot-token",
      dmPolicy: "allowlist",
      allowFrom: ["${TELEGRAM_OWNER_ID}"],
      groupPolicy: "disabled",
      groups: {},
      richMessages: false,
      errorPolicy: "silent",
      capabilities: { inlineButtons: "dm" },
      streaming: { mode: "off" },
      joinIntro: false,
      configWrites: false,
      actions: {
        sendMessage: true,
        deleteMessage: false,
        reactions: false,
        sticker: false,
        poll: false,
      },
    },
  },
  commands: {
    native: false,
    nativeSkills: false,
    ownerAllowFrom: ["telegram:${TELEGRAM_OWNER_ID}"],
    config: false,
  },
  tools: {
    // Profiles are applied before explicit allowlists. Use the unrestricted base,
    // then reduce the callable surface to these exact plugin tools.
    profile: "full",
    allow: [
      "assistant_mode_get",
      "assistant_mode_set",
      "calendar_read_busy_range",
      "calendar_read_agenda_range",
      "calendar_create_flexible_block",
      "calendar_reschedule_managed_block",
      "finance_import_statement",
      "finance_reconcile_month",
      "couple_record_shared_expense",
      "couple_record_settlement",
      "couple_summary",
      "coaching_record_checkin",
      "coaching_summary",
      "coaching_claim_proactive",
      "sales_create_prospect",
      "sales_prepare_outreach",
      "sales_record_outcome",
      "sales_metrics_30_days",
      "routine_plan_day",
      "routine_close_day",
      "routine_plan_week",
      "routine_guide_today",
      "academic_import_ics",
      "task_create",
      "task_list",
      "task_complete",
      "reminder_create",
      "reminder_list",
      "academic_fact_record",
      "academic_fact_list",
      "study_handoff_create",
      "study_handoff_list",
      "study_report_ingest",
      "study_material_record",
      "study_material_list",
      "drive_materials_sync",
      "drive_materials_list",
    ],
    deny: [
      "gateway",
      "nodes",
      "cron",
      "group:automation",
      "group:runtime",
      "group:fs",
      "group:web",
      "exec",
      "process",
      "browser",
      "read",
      "write",
      "edit",
      "apply_patch",
      "sessions_spawn",
      "sessions_send",
      "message",
    ],
    exec: { security: "deny", ask: "always" },
    elevated: { enabled: false },
    sessions: { visibility: "self" },
    agentToAgent: { enabled: false },
  },
  cron: {
    enabled: true,
    skipMissedJobs: true,
    triggers: { enabled: false },
    sessionRetention: "24h",
  },
  plugins: {
    load: { paths: ["${JARVIS_PLUGIN_PATH}"] },
    entries: {
      "jarvis-tools": {
        enabled: true,
        config: {
          primaryCalendarId: "${GOOGLE_PRIMARY_CALENDAR_ID}",
          managedCalendarId: "${GOOGLE_MANAGED_CALENDAR_ID}",
          importDirectory: "/data/jarvis-v1/imports",
          databasePath: "${JARVIS_DATABASE_PATH}",
          googleClientIdFile: "/data/jarvis-v1/credentials/google-client-id",
          googleClientSecretFile: "/data/jarvis-v1/credentials/google-client-secret",
          googleRefreshTokenFile: "/data/jarvis-v1/credentials/google-refresh-token",
        },
      },
    },
  },
}
