{
  // Secrets are injected by the systemd EnvironmentFile and never committed.
  gateway: {
    mode: "local",
    bind: "loopback",
    port: 18789,
    auth: {
      mode: "token",
      token: "${OPENCLAW_GATEWAY_TOKEN}",
      allowTailscale: false,
    },
    tailscale: { mode: "serve" },
  },
  session: { dmScope: "per-channel-peer" },
  agents: {
    defaults: {
      workspace: "/var/lib/openclaw/workspace",
      userTimezone: "America/Bogota",
      model: {
        primary: "openai/gpt-5.6-luna",
        fallbacks: [],
      },
      modelPolicy: { allow: ["openai/gpt-5.6-luna"] },
      models: {
        "openai/gpt-5.6-luna": {
          agentRuntime: { id: "openclaw" },
          params: { thinking: "low", fastMode: false },
        },
      },
      thinkingDefault: "low",
      heartbeat: { every: "0m" },
      sandbox: {
        mode: "all",
        backend: "podman",
        scope: "session",
        workspaceAccess: "none",
        docker: {
          image: "openclaw-sandbox:bookworm-slim",
          network: "none",
          readOnlyRoot: true,
          capDrop: ["ALL"],
          tmpfs: ["/tmp", "/var/tmp", "/run"],
        },
      },
    },
  },
  channels: {
    telegram: {
      enabled: true,
      dmPolicy: "allowlist",
      allowFrom: ["${TELEGRAM_OWNER_ID}"],
      groupPolicy: "disabled",
      groups: {},
      richMessages: false,
      errorPolicy: "silent",
      capabilities: { inlineButtons: "dm" },
      streaming: { mode: "off" },
      joinIntro: false,
    },
  },
  commands: {
    native: false,
    nativeSkills: false,
    ownerAllowFrom: ["telegram:${TELEGRAM_OWNER_ID}"],
  },
  tools: {
    // Profiles are applied before explicit allowlists. Use the unrestricted base,
    // then reduce the callable surface to these exact plugin tools.
    profile: "full",
    allow: [
      "assistant_mode_get",
      "assistant_mode_set",
      "calendar_read_busy_range",
      "calendar_read_agenda_range",
      "calendar_create_flexible_block",
      "calendar_reschedule_managed_block",
      "finance_import_statement",
      "finance_reconcile_month",
      "couple_record_shared_expense",
      "couple_record_settlement",
      "couple_summary",
      "coaching_record_checkin",
      "coaching_summary",
      "coaching_claim_proactive",
      "sales_create_prospect",
      "sales_prepare_outreach",
      "sales_record_outcome",
      "sales_metrics_30_days",
      "routine_plan_day",
      "routine_close_day",
      "routine_plan_week",
      "routine_guide_today",
      "academic_import_ics",
      "task_create",
      "task_list",
      "task_complete",
      "reminder_create",
      "reminder_list",
      "academic_fact_record",
      "academic_fact_list",
      "study_handoff_create",
      "study_handoff_list",
      "study_report_ingest",
      "study_material_record",
      "study_material_list",
      "drive_materials_sync",
      "drive_materials_list",
    ],
    deny: [
      "group:automation",
      "group:runtime",
      "group:fs",
      "group:web",
      "exec",
      "process",
      "browser",
      "read",
      "write",
      "edit",
      "apply_patch",
      "sessions_spawn",
      "sessions_send",
      "message",
    ],
    exec: { security: "deny", ask: "always" },
    elevated: { enabled: false },
    sessions: { visibility: "self" },
    agentToAgent: { enabled: false },
    sandbox: {
      tools: {
        allow: [
          "assistant_mode_get",
          "assistant_mode_set",
          "calendar_read_busy_range",
          "calendar_read_agenda_range",
          "calendar_create_flexible_block",
          "calendar_reschedule_managed_block",
          "finance_import_statement",
          "finance_reconcile_month",
          "couple_record_shared_expense",
          "couple_record_settlement",
          "couple_summary",
          "coaching_record_checkin",
          "coaching_summary",
          "coaching_claim_proactive",
          "sales_create_prospect",
          "sales_prepare_outreach",
          "sales_record_outcome",
          "sales_metrics_30_days",
          "routine_plan_day",
          "routine_close_day",
          "routine_plan_week",
          "routine_guide_today",
          "academic_import_ics",
          "task_create",
          "task_list",
          "task_complete",
          "reminder_create",
          "reminder_list",
          "academic_fact_record",
          "academic_fact_list",
          "study_handoff_create",
          "study_handoff_list",
          "study_report_ingest",
          "study_material_record",
          "study_material_list",
          "drive_materials_sync",
          "drive_materials_list",
        ],
      },
    },
  },
  cron: {
    enabled: true,
    skipMissedJobs: true,
    triggers: { enabled: false },
    sessionRetention: "24h",
  },
  plugins: {
    load: { paths: ["${JARVIS_PLUGIN_PATH}"] },
    entries: {
      "jarvis-tools": {
        enabled: true,
        config: {
          primaryCalendarId: "${GOOGLE_PRIMARY_CALENDAR_ID}",
          managedCalendarId: "${GOOGLE_MANAGED_CALENDAR_ID}",
          importDirectory: "${JARVIS_IMPORT_DIR}",
          databasePath: "${JARVIS_DATABASE_PATH}",
          googleClientIdFile: "${GOOGLE_CLIENT_ID_FILE}",
          googleClientSecretFile: "${GOOGLE_CLIENT_SECRET_FILE}",
          googleRefreshTokenFile: "${GOOGLE_REFRESH_TOKEN_FILE}",
        },
      },
    },
  },
}
