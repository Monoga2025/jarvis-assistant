[Unit]
Description=OpenClaw Jarvis Gateway
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=openclaw
Group=openclaw
EnvironmentFile=/etc/jarvis-v1.env
Environment=OPENCLAW_CONFIG_PATH=/var/lib/openclaw/openclaw.json5
Environment=OPENCLAW_STATE_DIR=/var/lib/openclaw
Environment=OPENCLAW_WORKSPACE_DIR=/var/lib/openclaw/workspace
Environment=TZ=America/Bogota
ExecStart=/usr/local/bin/openclaw gateway
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openclaw /opt/jarvis-v1/plugins/jarvis-tools
UMask=0077

[Install]
WantedBy=multi-user.target