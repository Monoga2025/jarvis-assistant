{
  "name": "jarvis-v1",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "tsc -p plugins/jarvis-tools/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:calendar": "node --import tsx --test test/calendar.test.ts",
    "test:finance": "node --import tsx --test test/finance.test.ts",
    "test:sales": "node --import tsx --test test/sales.test.ts",
    "test:routine": "node --import tsx --test test/routine.test.ts",
    "test:ics": "node --import tsx --test test/ics.test.ts",
    "calendar:oauth": "node --import tsx scripts/google-calendar-oauth.ts",
    "lint": "eslint .",
    "audit:config": "node --import tsx scripts/audit-config.ts",
    "verify": "npm run test && npm run typecheck && npm run lint && npm run build && npm run plugin:validate && npm run package:check && npm run audit:config",
    "plugin:build": "npm run build && cd plugins/jarvis-tools && openclaw plugins build --entry dist/index.js --check",
    "plugin:validate": "cd plugins/jarvis-tools && openclaw plugins validate --entry dist/index.js --json",
    "package:check": "node --import tsx scripts/check-production-package.ts"
  },
  "dependencies": {
    "json5": "2.2.3",
    "openclaw": "2026.9.1",
    "pdfjs-dist": "5.4.149",
    "typebox": "1.3.17"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "24.7.0",
    "eslint": "9.35.0",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.0"
  },
  "openclaw": {
    "extensions": [
      "./plugins/jarvis-tools/dist/index.js"
    ]
  }
}
