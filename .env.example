# Copy to /etc/jarvis-v1.env on the VPS, fill values, chown root:root, chmod 0600.
DIGITALOCEAN_PURCHASE_APPROVED=
TAILSCALE_AUTH_READY=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
OPENCLAW_GATEWAY_TOKEN=
JARVIS_PLUGIN_PATH=/opt/jarvis-v1/plugins/jarvis-tools
JARVIS_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID_FILE=/etc/jarvis-v1-secrets/google-client-id
GOOGLE_CLIENT_SECRET_FILE=/etc/jarvis-v1-secrets/google-client-secret
GOOGLE_REFRESH_TOKEN_FILE=/etc/jarvis-v1-secrets/google-refresh-token
GOOGLE_PRIMARY_CALENDAR_ID=primary
GOOGLE_MANAGED_CALENDAR_ID=
JARVIS_IMPORT_DIR=/var/lib/openclaw/imports
JARVIS_DATABASE_PATH=/var/lib/openclaw/jarvis.sqlite
REMINDER_POLL_SECONDS=60
JARVIS_BACKUP_DESTINATION=/var/backups/jarvis-v1
BACKUP_AGE_RECIPIENT=

# Disabled by default. Enable only after Calendar is enabled and the dedicated list is provisioned.
JARVIS_GOOGLE_TASKS_ENABLED=false
GOOGLE_TASKS_LIST_ID=
JARVIS_GOOGLE_TASKS_CANARY_MODE=
JARVIS_GOOGLE_TASKS_POLL_SECONDS=60
